{
  "version": 2,
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/status",
      "dest": "/api/status.py"
    },
    {
      "src": "/trade",
      "dest": "/api/trade.py"
    },
    {
      "src": "/control",
      "dest": "/api/control.py"
    },
    {
      "src": "/signal",
      "dest": "/api/signal.py"
    },
    {
      "src": "/position",
      "dest": "/api/position.py"
    },
    {
      "src": "/",
      "dest": "/api/index.py"
    }
  ]
}
